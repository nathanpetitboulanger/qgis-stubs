           # and implement the few required pure virtual methods
           class MyGeocoderAlgorithm(QgsBatchGeocodeAlgorithm):

               def __init__(self):
                   super().__init__(my_geocoder)

               def displayName(self):
                   return "My Geocoder"

               def name(self):
