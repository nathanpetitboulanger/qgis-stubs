        """Sets the parent status bar. Messages that are shown on the parent status
        bar will be intercepted and shown on this status bar too.

        .. versionadded:: 3.8
        """
    def clearMessage(self) -> None:
        """Removes any temporary message being shown.

        .. seealso:: `showMessage`
