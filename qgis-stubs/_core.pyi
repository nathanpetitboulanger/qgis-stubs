        :param feedback: optional feedback object for early cancellation (since
                         QGIS 4.2).
        """
    def intersection(self, geom: typing.Optional[QgsAbstractGeometry], errorMsg: typing.Optional[typing.Optional[str]] = ..., parameters: QgsGeometryParameters = ..., feedback: typing.Optional[QgsFeedback] = ...) -> typing.Optional[QgsAbstractGeometry]:
