    def endPoint(self) -> 'QgsPoint': ...
    def startPoint(self) -> 'QgsPoint': ...
    def dropZValue(self) -> bool: ...
    def dropMValue(self) -> bool: ...
    def addZValue(self, zValue: float = ...) -> bool: ...
    def addMValue(self, mValue: float = ...) -> bool: ...
