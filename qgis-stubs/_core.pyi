    def sinkProperties(self, sink: typing.Optional[str], parameters: dict[typing.Optional[str], typing.Any], context: 'QgsProcessingContext', sourceProperties: dict[typing.Optional[str], QgsProcessingAlgorithm.VectorProperties]) -> QgsProcessingAlgorithm.VectorProperties: ...
    def prepareSource(self, parameters: dict[typing.Optional[str], typing.Any], context: 'QgsProcessingContext') -> None:
        """Read the source from ``parameters`` and ``context`` and set it

        .. versionadded:: 3.4
        """
    def request(self) -> QgsFeatureRequest:
        """Returns the feature request used for fetching features to process from
        the source layer. The default implementation requests all attributes and
        geometry.
        """
    def processAlgorithm(self, parameters: dict[typing.Optional[str], typing.Any], context: 'QgsProcessingContext', feedback: typing.Optional['QgsProcessingFeedback']) -> dict[str, typing.Any]: ...
    def sourceCrs(self) -> QgsCoordinateReferenceSystem:
        """Returns the source's coordinate reference system. This will only return
        a valid CRS when called from a subclasses'
        `QgsProcessingFeatureBasedAlgorithm.processFeature`
        implementation.
        """
    def initParameters(self, configuration: dict[typing.Optional[str], typing.Any] = ...) -> None:
        """Initializes any extra parameters added by the algorithm subclass. There
        is no need to declare the input source or output sink, as these are
        automatically created by QgsProcessingFeatureBasedAlgorithm.
        """
    def outputCrs(self, inputCrs: QgsCoordinateReferenceSystem) -> QgsCoordinateReferenceSystem:
        """Maps the input source coordinate reference system (``inputCrs``) to a
        corresponding output CRS generated by the algorithm. The default
        behavior is that the algorithm maintains the same CRS as the input
        source.

