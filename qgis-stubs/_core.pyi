        """rollback to save point, the save point is maintained and is "undertied\""""
    @typing.overload
    def createSavepoint(self) -> typing.Tuple[str, str]:
        """creates a save point returns empty string on error returns the last
        created savepoint if it's not dirty
        """
    @typing.overload
    def createSavepoint(self, savePointId: typing.Optional[str]) -> typing.Tuple[str, str]:
        """creates a save point returns empty string on error"""
    @staticmethod
    def supportsTransaction(layer: typing.Optional[QgsVectorLayer]) -> bool:
        """Checks if the provider of a given ``layer`` supports transactions."""
    def executeSql(self, sql: typing.Optional[str], isDirty: bool = ..., name: typing.Optional[str] = ...) -> typing.Tuple[bool, str]:
        """Execute the ``sql`` string.

        :param sql: The sql query to execute
        :param isDirty: Flag to indicate if the underlying data will be modified
        :param name: Name of the transaction ( only used if `isDirty` is
                     ``True``)

