           pt_z.asWkt() # PointZ(120 343 77)

           pt_m = QgsPoint(33, 88, m=5)
           pt_m.m() # 5
           pt_m.wkbType() # 2001 (QgsWkbTypes.PointM)

           pt = QgsPoint(30, 40, wkbType=QgsWkbTypes.PointZ)
