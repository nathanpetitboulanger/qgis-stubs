class QgsVectorTileWriter(PyQt6.sip.wrapper):
    """Takes care of writing vector tiles.

    The intended use is to set up the class by setting the destination URI,
    extent, zoom level range and input vector layers. Then with a call to
    `writeTiles` the data gets written. In case of a failure,
    `errorMessage` returns the cause of the problem during
    writing.

    The syntax of destination URIs is the same like the data source string
    used by vector tile layers: parameters are encoded as a HTTP query
    string, where "type" key determines the type of the destination
    container, the "url" key is normally the path. Currently supported
    types:

    - "xyz" - tile data written as local files, using a template where
      {x},{y},{z} are replaced by the actual tile column, row and zoom level
      numbers, e.g.: file:///home/qgis/tiles/{z}/{x}/{y}.pbf
    - "mbtiles" - tile data written to a new MBTiles file, the "url" key
      should be ordinary file system path, e.g.: /home/qgis/output.mbtiles

    Currently the writer only support MVT encoding of data.

    Metadata support: it is possible to pass a QVariantMap with metadata.
    This is backend dependent. Currently only "mbtiles" source type supports
    writing of metadata. The key-value pairs will be written to the
    "metadata" table in the MBTiles file. Some useful metadata keys listed
    here, but see MBTiles spec for more details:

    - "name" - human-readable name of the tileset
    - "bounds" - extent in WGS 84: "minlon,minlat,maxlon,maxlat"
    - "center" - default view of the map: "longitude,latitude,zoomlevel"
    - "minzoom" - lowest zoom level
    - "maxzoom" - highest zoom level
    - "attribution" - string that explains the sources of data
    - "description" - descriptions of the content
    - "type" - whether this is an overlay or a basemap
    - "version" - version of the tileset

    Vector tile writer always writes "format" and "json" metadata. If not
    specified in metadata by the client, tile writer also writes "name",
    "bounds", "minzoom" and "maxzoom".

    .. versionadded:: 3.14
    """

    class Layer(PyQt6.sip.wrapper):
        """Configuration of a single input vector layer to be included in the
        output.

        .. versionadded:: 3.14

        QgsVectorTileWriter.Layer(layer: QgsVectorLayer|None)
        Constructs an entry for a vector layer

        QgsVectorTileWriter.Layer(a0: QgsVectorTileWriter.Layer)
        """

        @typing.overload
        def __init__(self, layer: typing.Optional[QgsVectorLayer]) -> None: ...
        @typing.overload
        def __init__(self, a0: 'QgsVectorTileWriter.Layer') -> None: ...

        def setMaxZoom(self, maxzoom: int) -> None:
            """Sets maximum zoom level at which this layer will be used. Negative value
            means no max. zoom level
            """
        def maxZoom(self) -> int:
            """Returns maximum zoom level at which this layer will be used. Negative
            value means no max. zoom level
            """
        def setMinZoom(self, minzoom: int) -> None:
            """Sets minimum zoom level at which this layer will be used. Negative value
            means no min. zoom level
            """
        def minZoom(self) -> int:
            """Returns minimum zoom level at which this layer will be used. Negative
            value means no min. zoom level
            """
        def setLayerName(self, name: typing.Optional[str]) -> None:
            """Sets layer name in the output. If not set,
            `Layer.layer`->`Layer.name` will be used.
            """
        def layerName(self) -> str:
            """Returns layer name in the output. If not set,
            `Layer.layer`->`Layer.name` will be used.
            """
        def setFilterExpression(self, expr: typing.Optional[str]) -> None:
            """Sets filter expression. If not empty, only features matching the
            expression will be used
            """
        def filterExpression(self) -> str:
            """Returns filter expression. If not empty, only features matching the
            expression will be used
            """
        def layer(self) -> typing.Optional[QgsVectorLayer]:
            """Returns vector layer of this entry"""

    @typing.overload
    def __init__(self) -> None: ...
    @typing.overload
    def __init__(self, a0: 'QgsVectorTileWriter') -> None: ...

    def writeSingleTile(self, tileID: QgsTileXYZ, feedback: typing.Optional[QgsFeedback] = ..., buffer: int = ..., resolution: int = ...) -> QtCore.QByteArray:
        """Encodes single MVT tile

        :param tileID: Tile identifier
        :param feedback: optional, provide cancellation functionality
        :param resolution: the resolution of coordinates of geometries within
                           the tile. The default is 4096
        :param buffer: size of the buffer zone around tile edges in integer tile
                       coordinates. The default is 256 (~6%)

        Returns a QByteArray with the encoded data

        .. versionadded:: 3.22
        """
    def fullExtent(self) -> QgsRectangle:
        """Returns calculated extent that combines extent of all input layers"""
    def errorMessage(self) -> str:
        """Returns error message related to the previous call to
        `QgsVectorTileWriter.writeTiles`. Will return an empty string
        if writing was successful.
        """
    def writeTiles(self, feedback: typing.Optional[QgsFeedback] = ...) -> bool:
        """Writes vector tiles according to the configuration. Returns ``True`` on
        success (upon failure one can get error cause using
        `QgsVectorTileWriter.errorMessage`)

        If a pointer to a feedback object is provided, it can be used to track
        progress or provide cancellation functionality.
        """
    def setRootTileMatrix(self, tileMatrix: QgsTileMatrix) -> bool:
        """Sets zoom level 0 tile matrix"""
    def setTransformContext(self, transformContext: QgsCoordinateTransformContext) -> None:
        """Sets coordinate transform context for transforms between layers and tile
        matrix CRS
        """
    def setMetadata(self, metadata: dict[typing.Optional[str], typing.Any]) -> None:
        """Sets that will be written to the output dataset. See class description
        for more on metadata support
        """
    def setLayers(self, layers: collections.abc.Iterable['QgsVectorTileWriter.Layer']) -> None:
        """Sets vector layers and their configuration for output of vector tiles"""
    def setMaxZoom(self, maxZoom: int) -> None:
        """Sets the maximum zoom level of tiles. Allowed values are in interval
        [0,24]
        """
    def setMinZoom(self, minZoom: int) -> None:
        """Sets the minimum zoom level of tiles. Allowed values are in interval
        [0,24]
        """
    def setExtent(self, extent: QgsRectangle) -> None:
        """Sets extent of vector tile output. If unset, it will use the full extent
        of all input layers combined
        """
    def setDestinationUri(self, uri: typing.Optional[str]) -> None:
        """Sets where and how the vector tiles will be written. See the class
        description about the syntax of destination URIs.
        """


