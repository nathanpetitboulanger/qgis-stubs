    @typing.overload
    def __init__(self, a0: 'QgsMapLayerRenderer') -> None: ...

    def appendRenderedItemDetails(self, details: typing.Optional['QgsRenderedItemDetails']) -> None:
        """Appends the ``details`` of a rendered item to the renderer.

        Rendered item details can be retrieved by calling
        `QgsMapLayerRenderer.takeRenderedItemDetails`.

        Ownership of ``details`` is transferred to the renderer.

        .. seealso:: `takeRenderedItemDetails`

        .. versionadded:: 3.22
        """
    def takeRenderedItemDetails(self) -> list['QgsRenderedItemDetails']:
        """Takes the list of rendered item details from the renderer.

