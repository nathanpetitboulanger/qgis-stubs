        """Returns the output file format.

        .. seealso:: `setFileFormat`
        """
    def setFileFormat(self, format: QtMultimedia.QMediaFormat.FileFormat) -> None:
        """Sets the output file ``format``.

        The Qt QMediaFormat.supportedFileFormats() method can be used to
