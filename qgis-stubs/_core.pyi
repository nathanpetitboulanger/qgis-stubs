    Construct a feedback object
    """

    def __init__(self, parent: typing.Optional[QtCore.QObject] = ...) -> None: ...

    processedCountChanged: typing.ClassVar[QtCore.pyqtSignal]
    progressChanged: typing.ClassVar[QtCore.pyqtSignal]
    canceled: typing.ClassVar[QtCore.pyqtSignal]
    def cancel(self) -> None:
        """Tells the internal routines that the current operation should be
        canceled. This should be run by the main thread
        """
    @staticmethod
    def createScaledFeedback(parentFeedback: typing.Optional['QgsFeedback'], startPercentage: float, endPercentage: float) -> typing.Optional['QgsFeedback']:
        """Returns a feedback object whose [0, 100] progression range will be
        mapped to ``parentFeedback`` [``startPercentage``, ``endPercentage``].

        Cancellation on the returned feedback causes cancellation of the parent
        feedback.

        ``parentFeedback`` must be kept alive while the returned feedback is
        used.

        .. versionadded:: 4.0
        """
    def setProcessedCount(self, processedCount: int) -> None:
        """Sets the current processed objects count for the feedback object. The
        ``processedCount`` argument is an unsigned long integer and starts from
        0.

        .. seealso:: `processedCount`

        .. seealso:: `processedCountChanged`

        .. versionadded:: 3.24
        """
    def processedCount(self) -> int:
        """Returns the current processed objects count reported by the feedback
        object. Depending on how the feedback object is used processed count
        reporting may not be supported. The returned value is an unsigned long
        integer and starts from 0.

        .. seealso:: `setProcessedCount`

        .. seealso:: `processedCountChanged`

        .. versionadded:: 3.24
        """
    def progress(self) -> float:
        """Returns the current progress reported by the feedback object. Depending
        on how the feedback object is used progress reporting may not be
        supported. The returned value is in percentage and ranges from 0-100.

        .. seealso:: `setProgress`

        .. seealso:: `progressChanged`
        """
    def setProgress(self, progress: float) -> None:
        """Sets the current progress for the feedback object. The ``progress``
